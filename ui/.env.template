VITE_ALGOD_PORT=""
VITE_ALGOD_NETWORK="mainnet"

# Read algod (optional): every protocol read goes through this node. A dtalgorand node with
# time travel (GET /v2/transactions/simulate/limits reports "time-travel": true) enables the
# history features: viewing any page as of a past round, change timelines and charts.
# Unset, reads use VITE_ALGOD_* above and the history features are hidden.
# A dtalgorand node that also has queries (its limits list "query") serves the same reads faster
# through POST /v2/query; otherwise reads simulate.
VITE_DT_ALGOD_TOKEN=""
VITE_DT_ALGOD_SERVER=""
VITE_DT_ALGOD_PORT=""

# Block Explorer
VITE_EXPLORER_ACCOUNT_URL=https://algo.surf/account
